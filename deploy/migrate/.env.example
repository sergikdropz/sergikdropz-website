# Cloudflare R2 — https://dash.cloudflare.com → R2 → Manage R2 API Tokens
# S3 credentials (Object Read & Write on the production bucket):
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sergik-vault

# Cloudflare API token (Account → Cloudflare R2 → Edit) — enables r2.dev public URL
CLOUDFLARE_API_TOKEN=

# Set automatically by enable-r2-public.mjs (https://pub-xxxxx.r2.dev)
R2_PUBLIC_BASE_URL=

# Optional custom S3 endpoint
# R2_ENDPOINT=

# --- Backup layout (legacy upload-r2.mjs) ---
R2_PREFIX=backup/2026-08-25

# Skip objects that already exist on re-upload (set 0 to force)
# R2_SKIP_EXISTING=1
