{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "title":"FAQ",
  "type":"object",
  "required":["id","question","answer"],
  "properties":{
    "id":{"type":"string"},
    "question":{"type":"string"},
    "answer":{"type":"string"},
    "tags":{"type":"array","items":{"type":"string"}},
