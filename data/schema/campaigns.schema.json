{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Campaign",
  "type": "object",
  "required": ["id","artist_id","name","created_at"],
  "properties": {
    "id":{"type":"string"},
    "artist_id":{"type":"string"},
    "name":{"type":"string"},
    "status":{"type":"string","enum":["draft","running","paused","completed"]},
    "start_date":{"type":["string","null"],"format":"date"},
    "end_date":{"type":["string","null"],"format":"date"},
    "budget_total_usd":{"type":["number","null"],"minimum":0},
    "budget_daily_usd":{"type":["number","null"],"minimum":0},
    "frontload_pattern":{"type":["object","null"]},
    "ad_account_id":{"type":["string","null"]},
    "targeting":{"type":["object","null"]},
    "creatives":{"type":"array","items":{"type":"string"}},
    "landing_page_url":{"type":["string","null"],"format":"uri"},
    "conversion_metric":{"type":["string","null"]},
    "created_at":{"type":"string","format":"date-time"},
    "updated_at":{"type":["string","null"],"format":"date-time"}
  }
}
