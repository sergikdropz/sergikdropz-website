{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "title":"Integration",
  "type":"object",
  "properties":{
    "id":{"type":"string"},
    "name":{"type":"string"},
    "type":{"type":"string","enum":["ads","music","payments","db"]},
    "capabilities":{"type":"array","items":{"type":"string"}},
    "required_permissions":{"type":"array","items":{"type":"string"}},
    "setup_steps":{"type":"array","items":{"type":"string"}},
    "webhook_endpoints":{"type":"array","items":{"type":"string","format":"uri"}},
    "docs_url":{"type":"string","format":"uri"}
  }
}
