# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Authentication
NEXTAUTH_SECRET=your-secret-key
NEXTAUTH_URL=http://localhost:3000
# Fan sign-in is passwordless (magic link). Add to Supabase Auth → URL config:
#   Site URL + Redirect URLs: ${NEXT_PUBLIC_SITE_URL}/auth/callback
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# HMAC secret for email-only vault unlock cookie (min 16 chars; use long random in production)
FAN_VAULT_UNLOCK_SECRET=change-me-to-a-long-random-string
# Fan + admin: Supabase Auth ( /fan/login magic link, /admin/login as configured )

# Email (Resend)
RESEND_API_KEY=your-resend-api-key
NEXT_PUBLIC_FROM_EMAIL=noreply@sergikdropz.com
NEXT_PUBLIC_FROM_NAME=SERGIK

# Payments (Stripe)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-pk
STRIPE_SECRET_KEY=your-stripe-sk

# Cron Jobs
CRON_SECRET=your-secret-cron-token

# Analytics (Optional)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=your-ga-id
NEXT_PUBLIC_MIXPANEL_TOKEN=your-mixpanel-token

# Feature Flags
NEXT_PUBLIC_ENABLE_CAMPAIGNS=true
NEXT_PUBLIC_ENABLE_MISSIONS=false
NEXT_PUBLIC_ENABLE_ANALYTICS=true
