# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Authentication
NEXTAUTH_SECRET=your-secret-key
NEXTAUTH_URL=http://localhost:3000
# Fan sign-in is passwordless (magic link). Add to Supabase Auth → URL config:
#   Site URL + Redirect URLs: ${NEXT_PUBLIC_SITE_URL}/auth/callback
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# HMAC secret for email-only vault unlock cookie (min 16 chars; use long random in production)
FAN_VAULT_UNLOCK_SECRET=change-me-to-a-long-random-string
# Fan + admin: Supabase Auth ( /fan/login magic link, /admin/login as configured )

# Dev-only admin auto-login: GET /api/auth/auto-login or /admin/login?autologin=1
# ADMIN_AUTO_LOGIN_EMAIL=admin@example.com
# ADMIN_AUTO_LOGIN_PASSWORD=

# Dev-only admin auto-login: GET /api/auth/auto-login or /admin/login?autologin=1
# ADMIN_AUTO_LOGIN_EMAIL=admin@example.com
# ADMIN_AUTO_LOGIN_PASSWORD=

# Email (Resend)
RESEND_API_KEY=your-resend-api-key
NEXT_PUBLIC_FROM_EMAIL=noreply@sergikdropz.com
NEXT_PUBLIC_FROM_NAME=SERGIK

# Payments (Stripe)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-pk
STRIPE_SECRET_KEY=your-stripe-sk

# Instagram — Graph API (best reliability for homepage grid)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Instagram — Meta app token for Graph `instagram_oembed` when public oEmbed is flaky (same app as Graph API)
META_APP_ID=
META_APP_SECRET=

# Homepage Instagram: optional override. Leave unset to use /admin/instagram (Supabase `homepage_instagram_feed_enabled`). Use false/true only as an emergency kill-switch or force-on.
NEXT_PUBLIC_SHOW_INSTAGRAM_FEED=

# Cron Jobs
CRON_SECRET=your-secret-cron-token

# Analytics (Optional)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=your-ga-id
NEXT_PUBLIC_MIXPANEL_TOKEN=your-mixpanel-token

# Media CDN (Cloudflare R2 custom domain — skips Vercel audio proxy when set)
# NEXT_PUBLIC_MEDIA_CDN_URL=https://media.sergikdropz.com
# R2_PUBLIC_BASE_URL=https://media.sergikdropz.com
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=sergik-vault

# Feature Flags
NEXT_PUBLIC_ENABLE_CAMPAIGNS=true
NEXT_PUBLIC_ENABLE_MISSIONS=false
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# Local dev daemon (optional — defaults are safe)
# SONIC_DNA_WATCH=0
# DEV_DAEMON_NEXT_ROTATE_MS=14400000

# Dual database profiles (cloud primary + home-server backup)
# SERGIK_CLOUD_SUPABASE_URL=https://YOUR_REF.supabase.co
# SERGIK_CLOUD_SUPABASE_ANON_KEY=
# SERGIK_CLOUD_SERVICE_ROLE_KEY=
# SERGIK_HOME_SUPABASE_URL=http://127.0.0.1:8000
# SERGIK_HOME_SUPABASE_ANON_KEY=
# SERGIK_HOME_SERVICE_ROLE_KEY=
# SERGIK_DB_TARGET=cloud
