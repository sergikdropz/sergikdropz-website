{
  "name": "sergik-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf .next .next-dev-* .next-build node_modules/.cache",
    "dev": "NEXT_DIST_DIR=.next-dev-3001 WATCHPACK_POLLING=true NEXT_WEBPACK_POLL=1 next dev -p 3001",
    "dev:3000": "NEXT_DIST_DIR=.next-dev-3000 WATCHPACK_POLLING=true NEXT_WEBPACK_POLL=1 next dev -p 3000",
    "dev:recover": "node scripts/recover-dev-server.mjs",
    "dev:clean": "npm run clean && npm run dev",
    "dev:status": "node scripts/dev-status.mjs",
    "dev:verify": "node scripts/verify-dev-server.mjs",
    "dev:ensure": "node scripts/dev-ensure.mjs",
    "dev:daemon": "node scripts/dev-daemon.mjs",
    "dev:stop": "node scripts/dev-stop.mjs",
    "dev:restart": "node scripts/dev-stop.mjs && node scripts/dev-ensure.mjs",
    "env:cloud": "node ../deploy/home-server/scripts/switch-web-env-cloud.mjs",
    "env:home-server": "node ../deploy/home-server/scripts/switch-web-env.mjs",
    "db:verify": "node ../deploy/supabase-foundation/verify-cloud.mjs",
    "db:init-cloud-profile": "node ../deploy/supabase-foundation/init-cloud-profile.mjs",
    "db:schema-bundle": "node ../deploy/supabase-foundation/build-schema-bundle.mjs",
    "db:bootstrap-cloud": "node ../deploy/supabase-foundation/bootstrap-cloud.mjs",
    "db:sync-pair": "node ../deploy/supabase-foundation/sync-pair.mjs",
    "db:backup": "node ../deploy/supabase-foundation/backup-snapshot.mjs",
    "db:finish-vercel-cloud": "node ../deploy/supabase-foundation/finish-cloud-from-vercel.mjs",
    "db:playwright-vercel-supabase": "node ../deploy/supabase-foundation/playwright-vercel-supabase.mjs",
    "db:seed-cloud-admin": "node ../deploy/supabase-foundation/seed-cloud-admin.mjs",
    "db:migrate-auto-dj": "node scripts/apply-auto-dj-migration.mjs",
    "sync:import": "node scripts/import-local-to-supabase.mjs",
    "predev": "node scripts/ensure-port-free.mjs 3001 && npm run knowledge:build",
    "predev:3000": "node scripts/ensure-port-free.mjs 3000 && npm run knowledge:build",
    "prebuild": "npm run knowledge:build",
    "build": "next build",
    "start": "next start",
    "start:3001": "next start -p 3001",
    "lint": "next lint",
    "lint:gate": "next lint --file middleware.ts --file instrumentation.ts --dir lib/auth",
    "typecheck": "tsc --noEmit",
    "vercel:preflight": "node scripts/vercel-preflight.mjs",
    "vercel:build": "node scripts/vercel-preflight.mjs && npm run build",
    "deploy:check": "npm run lint:gate && npm run typecheck && npm run vercel:preflight && npm run build",
    "devtools": "react-devtools",
    "test:e2e:install-browsers": "playwright install chromium",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report playwright-report",
    "test:e2e:perf": "PLAYWRIGHT_PERF=1 playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "health:probe": "node scripts/probe-health-deps.mjs",
    "knowledge:build": "node scripts/build-site-knowledge.mjs",
    "knowledge:verify": "node scripts/build-site-knowledge.mjs --check",
    "knowledge:watch": "node scripts/watch-site-knowledge.mjs",
    "sonic-dna:sync": "node ../knowledge/scripts/sync-sonic-dna-analysis.mjs",
    "sonic-dna:remasure": "node ../knowledge/scripts/diagnostic-remasure-sonic-dna.mjs --library-only --apply",
    "sonic-dna:remasure:mp3": "node ../knowledge/scripts/diagnostic-remasure-sonic-dna.mjs --library-only --mp3-fallback --apply --live",
    "sonic-dna:remasure:dry": "node ../knowledge/scripts/diagnostic-remasure-sonic-dna.mjs --library-only --dry-run",
    "sonic-dna:compile": "node ../knowledge/scripts/compile_library_analysis.mjs && node ../knowledge/scripts/report_sonic_dna.mjs",
    "sonic-dna:apply": "node ../knowledge/scripts/apply_sonic_dna_measured.mjs --compile",
    "sonic-dna:bpm-backfill": "node ../knowledge/scripts/backfill-catalog-bpm-from-measured.mjs",
    "sonic-dna:phrase-backfill": "node ../knowledge/scripts/backfill-phrase-grid.mjs",
    "sonic-dna:kick-onset-backfill": "node ../knowledge/scripts/backfill-kick-onsets.mjs",
    "sonic-dna:watch": "node ../knowledge/scripts/watch-sonic-dna-analysis.mjs",
    "sonic-dna:train-genre": "npx tsx ../knowledge/scripts/train-genre-engine.mjs",
    "vault:apply-export-dates": "npx tsx scripts/apply-export-created-dates.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.72.1",
    "@aws-sdk/client-s3": "^3.1119.0",
    "@aws-sdk/s3-request-presigner": "^3.1119.0",
    "@sentry/nextjs": "^10.51.0",
    "@stripe/stripe-js": "^2.4.0",
    "@supabase/supabase-js": "^2.90.1",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-virtual": "^3.0.0",
    "basic-ftp": "^5.2.2",
    "dotenv": "^17.2.3",
    "framer-motion": "^10.16.16",
    "music-metadata": "^11.12.3",
    "next": "^14.2.0",
    "peaks.js": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.5.0",
    "react-window": "^2.2.5",
    "react-window-infinite-loader": "^2.0.1",
    "realtime-bpm-analyzer": "^5.0.0",
    "recharts": "^3.6.0",
    "resend": "^3.2.0",
    "signalsmith-stretch-js": "^0.2.0",
    "stripe": "^14.25.0",
    "swr": "^2.3.8",
    "tone": "^15.1.22",
    "ua-parser-js": "^2.0.8",
    "wavesurfer.js": "^7.12.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.49.1",
    "@tanstack/react-query-devtools": "^5.91.2",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "aubiojs": "^0.2.1",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "^14.2.0",
    "music-tempo": "^1.0.3",
    "node-wav": "^0.0.2",
    "postcss": "^8",
    "react-devtools": "^7.0.1",
    "tailwindcss": "^3.3.0",
    "typescript": "^5",
    "vercel": "^50.1.6",
    "vitest": "^3.2.4"
  }
}
