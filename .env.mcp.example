# Copy to .env.mcp and fill in (see AGENTS.md — MCP & project knowledge).
# .env.mcp is gitignored. Values here are for your reference when editing .cursor/mcp.json.

# GitHub: create a fine-scoped PAT (repo, read:org as needed) and paste into
# .cursor/mcp.json → mcpServers.github.headers.Authorization
#   Bearer __GITHUB_PAT__
GITHUB_PERSONAL_ACCESS_TOKEN=

# Optional: higher rate limits for Context7 (https://context7.com/dashboard)
CONTEXT7_API_KEY=

# Firecrawl: https://firecrawl.dev — paste into mcp.json env for firecrawl server
FIRECRAWL_API_KEY=
